# SEC requires a User-Agent with your name and email: "First Last you@example.com"
SEC_USER_AGENT=
# Set to 1 to forbid network calls (use data/cache only)
VERITY_OFFLINE=0

# LLM provider (M3): anthropic | openai | ollama | replay
VERITY_PROVIDER=replay
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
VERITY_FAST_MODEL=
VERITY_STRONG_MODEL=
