# SEC requires a User-Agent with your name and email: "First Last you@example.com"
SEC_USER_AGENT=
# Set to 1 to forbid network calls (use data/cache only)
VERITY_OFFLINE=0

# Who writes and researches: rules (no model) | anthropic | openai | ollama
VERITY_PROVIDER=rules
# LLM cache: auto (use cache, call on a miss) | replay (cache only, no key) | off
VERITY_LLM_CACHE=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Optional overrides. Anthropic defaults: fast=claude-haiku-5-5, strong=claude-opus-5-5
VERITY_FAST_MODEL=
VERITY_STRONG_MODEL=
VERITY_EFFORT=medium
